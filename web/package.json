{
    "name": "gavil-web",
    "version": "0.1.0",
    "private": true,
    "description": "Gav-IL: HackIllinois 2027 judging + admin platform (Next.js 16 on Cloudflare via OpenNext)",
    "scripts": {
        "sync": "node scripts/sync-design-system.mjs",
        "predev": "npm run sync",
        "dev": "next dev",
        "prebuild": "npm run sync",
        "build": "next build",
        "start": "next start",
        "lint": "eslint .",
        "typecheck": "next typegen && tsc --noEmit",
        "test": "vitest run",
        "format": "prettier --write '**/*.{ts,tsx,js,mjs,json,css}'",
        "format:check": "prettier --check '**/*.{ts,tsx,js,mjs,json,css}'",
        "build:worker": "npm run sync && env GAVIL_MOCK=0 GAVIL_MOCK_DEMO=0 GAVIL_MOCK_TALK=0 opennextjs-cloudflare build",
        "preview": "npm run build:worker && opennextjs-cloudflare preview",
        "deploy": "npm run build:worker && opennextjs-cloudflare deploy && npm run check:health",
        "check:health": "node scripts/check-health.mjs",
        "headers:file": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON lib/security/write-headers-file.mjs",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
    },
    "dependencies": {
        "@anthropic-ai/sdk": "^0.129.0",
        "@opennextjs/cloudflare": "^1.20.13",
        "jsqr": "^1.4.0",
        "next": "^16.4.2",
        "qrcode-generator": "^2.0.4",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "server-only": "^0.0.1"
    },
    "devDependencies": {
        "@types/node": "^22",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "eslint": "^9.39.5",
        "eslint-config-next": "16.4.2",
        "jsdom": "^26.1.0",
        "prettier": "3.6.2",
        "typescript": "^5.9.3",
        "vitest": "^3.2.4",
        "wrangler": "^4.149.0"
    }
}
