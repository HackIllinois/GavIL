# Gav-IL web: every environment variable the app reads (web/README.md → Environment has the same
# table). Server-only values are never NEXT_PUBLIC_; on Cloudflare set them with
# `wrangler secret put NAME` (non-secret values go in wrangler.jsonc `vars`).
# Make a random secret with:  openssl rand -base64 32

# Base URL of the adonix API (auth, judging, admin). Server-only and read at RUNTIME on every
# request, so a Wrangler `vars` override on a staging deploy takes effect (a NEXT_PUBLIC_ value is
# frozen into the build by `next build`). Not a secret. REQUIRED in production (wrangler.jsonc
# `vars` sets the default; a staging deploy overrides it).
ADONIX_URL=https://adonix.hackillinois.org
# Old name for ADONIX_URL, still read (at runtime) when ADONIX_URL is not set. Prefer ADONIX_URL:
# nothing in the browser needs this value.
# NEXT_PUBLIC_ADONIX_URL=https://adonix.hackillinois.org

# ── Mock mode (local development only) ──
# 1 = serve everything from lib/api/mock.ts and enable /auth/mock. Works ONLY under `next dev`
# (NODE_ENV=development) or vitest: `next start` and any deployed build refuse to boot with it.
# Never set this on a deployment.
GAVIL_MOCK=1
# 1 = demo sign-in shortcuts on top of mock mode: every email code is 123456 and
# /auth/magic?token=demo-<judgeId> works once. Off unless set; refuses to boot outside dev/test.
# GAVIL_MOCK_DEMO=1
# Mock mode only: 1 = start the in-memory event with Table talk and Claude highlights switched on.
# GAVIL_MOCK_TALK=1
# Mock mode only: overrides the dev secret mock session tokens are signed with.
# GAVIL_MOCK_SECRET=
# Build only (npm run sync): where the design system lives. Default ../design-system.
# GAVIL_DESIGN_SYSTEM=../design-system

# ── Production secrets and settings (server-only) ──
# Our public origin: one origin, or a comma-separated allow-list whose first entry is the default.
# Sent as Origin on every adonix write, and the ONLY source of the staff Google sign-in callback
# URL (the request's own host is used only when it is on this list, so a forged Host header never
# picks the callback). REQUIRED in production: a deployed build with no usable GAVIL_ORIGIN serves
# no judging or admin page (getApi throws on every request, so a deploy check catches it) and
# staff Google sign-in refuses to start. `next dev` and vitest need none. wrangler.jsonc `vars` sets
# https://judging.hackillinois.org; a staging deploy overrides it.
# GAVIL_ORIGIN=https://judging.hackillinois.org
# adonix's JWT_SECRET, shared with adonix (copy its value; do not generate a new one): every
# request's session is verified with a local HMAC. Optional but recommended; without it, one
# GET /auth/roles/ round trip per session token per minute.
# GAVIL_JWT_SECRET=
# Gav-IL only, never shared with adonix. REQUIRED in production: signs the 120 s placard scan
# grant that /t/<CODE> swaps the QR's k for. At least 32 characters; generate with
# openssl rand -base64 32. Without it no grant is minted and a scanned QR asks the judge to type
# the placard check instead.
# GAVIL_GRANT_SECRET=
# adonix only (placard QR tokens k are signed and checked there): Gav-IL's server never reads it
# outside mock mode, which uses a fixed dev secret. Listed here so one document names every
# secret of the platform.
# GAVIL_PLACARD_SECRET=

# ── Table talk (off by default; an admin must also switch it on in Settings) ──
# Shared with adonix (it verifies the same receipts and spend proofs). REQUIRED for Table talk:
# at least 32 characters; generate with openssl rand -base64 32. Without it every recording and
# highlights call answers 503 TalkNotConfigured.
# GAVIL_TALK_SECRET=
# Speech to text account: Cloudflare Workers AI whisper-large-v3-turbo over REST. REQUIRED for
# Table talk; without it (and outside mock mode) recordings answer 503 and judges type notes.
# CF_ACCOUNT_ID=
# Workers AI API token for that account. REQUIRED for Table talk, same as CF_ACCOUNT_ID.
# CF_API_TOKEN=
# Claude highlights. Optional: without a key the rule extractor alone runs.
# ANTHROPIC_API_KEY=
# Model for Claude highlights, only from the allowlist in lib/talk/llm.ts (anything else falls
# back to the default). Optional. Default: claude-opus-5-5 (Fable / Mythos are Covered Models with
# mandatory 30-day retention: avoid them for table transcripts).
# GAVIL_HIGHLIGHTS_MODEL=claude-opus-5-5
